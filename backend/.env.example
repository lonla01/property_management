# Copier ce fichier en .env et renseigner les vraies valeurs (ne jamais committer .env)

DATABASE_URL=jdbc:postgresql://localhost:5432/rental_management
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# CinetPay - laisser CINETPAY_SANDBOX=true tant qu'aucun compte marchand n'existe
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SANDBOX=true
CINETPAY_NOTIFY_URL=http://localhost:8080/api/webhooks/cinetpay
CINETPAY_RETURN_URL=http://localhost:5173/paiement/confirmation

# Notifications - laisser "simulated" tant qu'aucun compte Twilio/fournisseur SMS n'existe
NOTIFICATION_PROVIDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

REMINDER_BATCH_SIZE=25
REMINDER_BATCH_PAUSE_MS=2000
REMINDER_DAYS_BEFORE_DUE=5,1
OVERDUE_CADENCE_DAYS=1,3,7

FRONTEND_BASE_URL=http://localhost:5173
RECEIPTS_DIR=/tmp/receipts

# Clé partagée exigée par /api/rappels/executer-du-jour et /reessayer-echecs
SCHEDULER_KEY=change-me-to-a-random-string
